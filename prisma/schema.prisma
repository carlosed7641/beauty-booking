generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entity {
  id                    String       @id @default(uuid())
  logo                  String?
  cover                 String?
  name                  String?
  contactUrl            String?
  followers             Int          @default(0)
  scheduling            Int          @default(0)
  countryId             String
  ownerId               String       @unique
  address               String?
  addressReference      String?
  shopType              String?
  cancelDateTime        Int          @default(20)
  advanceBookingControl Int          @default(30)
  showAdminAgenda       Boolean      @default(true)
  country               Country      @relation(fields: [countryId], references: [id])
  owner                 User         @relation("EntityOwner", fields: [ownerId], references: [id])
  reviews               Review[]
  services              Service[]
  users                 User[]
  workdays              WorkDay[]
  samples               WorkSample[]
}

model User {
  id                  String            @id @default(uuid())
  name                String?
  birthDay            DateTime?
  gender              Gender?
  role                Role              @default(user)
  photo               String?
  indicator           String?
  phone               String?
  shareNumberPhone    Boolean           @default(false)
  description         String?
  artisticName        String?
  experienceArea      String?
  experienceYears     String?
  countryId           String?
  entityId            String?
  email               String            @unique
  password            String
  isPublicProfile     Boolean           @default(true)
  isRegisterCompleted Boolean           @default(false)
  isActive            Boolean           @default(true)
  entityOwner         Entity?           @relation("EntityOwner")
  customerEvents      Event[]           @relation("EventCustomer")
  professionalEvents  Event[]           @relation("EventProfessional")
  reviewsReceived     Review[]          @relation("ProfessionalReviews")
  reviewsWritten      Review[]          @relation("UserReviews")
  country             Country?          @relation(fields: [countryId], references: [id])
  entity              Entity?           @relation(fields: [entityId], references: [id])
  samples             WorkSample[]
  workExperiences     WorkExperience[]
  skills              Skill[]
  workDays            WorkDay[]
  serviceOverrides    ServiceOverride[]
}

model Event {
  id             String       @id @default(uuid())
  title          String
  start          DateTime
  end            DateTime
  isAdminBooking Boolean
  status         EventStatus?
  customerId     String
  professionalId String
  serviceId      String
  customer       User         @relation("EventCustomer", fields: [customerId], references: [id])
  professional   User         @relation("EventProfessional", fields: [professionalId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])
  review         Review?
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  professionalId String
  entityId       String
  eventId        String   @unique
  date           DateTime
  points         Float
  entity         Entity   @relation(fields: [entityId], references: [id])
  event          Event    @relation(fields: [eventId], references: [id])
  professional   User     @relation("ProfessionalReviews", fields: [professionalId], references: [id])
  user           User     @relation("UserReviews", fields: [userId], references: [id])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  category    String
  description String?

  basePrice           Int @default(0)
  baseDurationHours   Int @default(0)
  baseDurationMinutes Int @default(30)

  gender   Gender?
  archived Boolean @default(false)

  entityId String

  entity           Entity           @relation(fields: [entityId], references: [id])
  events           Event[]
  serviceOverrides ServiceOverride[]
}

model ServiceOverride {
  id String @id @default(uuid())

  serviceId      String
  professionalId String

  price    Int
  duration Int

  enabled      Boolean @default(true)
  service      Service @relation(fields: [serviceId], references: [id])
  professional User    @relation(fields: [professionalId], references: [id])

  @@unique([serviceId, professionalId])
}

model Skill {
  id         String  @id @default(uuid())
  name       String
  percentage Float
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
}

model WorkExperience {
  id        String    @id @default(uuid())
  company   String
  position  String
  startDate DateTime
  endDate   DateTime?
  city      String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkDay {
  id             String  @id @default(uuid())
  from           String
  to             String
  name           String
  order          Int
  disabled       Boolean @default(false)
  entityId       String?
  professionalId String?
  entity         Entity? @relation(fields: [entityId], references: [id])
  user           User?   @relation(fields: [professionalId], references: [id])
}

model WorkSample {
  id        String            @id @default(uuid())
  category  String
  name      String
  authorId  String
  entityId  String
  updatedAt DateTime          @default(now()) @updatedAt
  author    User              @relation(fields: [authorId], references: [id])
  entity    Entity            @relation(fields: [entityId], references: [id])
  images    WorkSampleImage[]
}

model WorkSampleImage {
  id       String     @id @default(uuid())
  url      String
  main     Boolean?
  sampleId String
  sample   WorkSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
}

model Country {
  id        String   @id @default(uuid())
  name      String
  shortName String
  indicator String
  entity    Entity[]
  users     User[]
}

enum Gender {
  men
  women
  other
}

enum Role {
  admin
  employee
  user
}

enum EventStatus {
  completed
  pending
  cancelled
  aborted
}
