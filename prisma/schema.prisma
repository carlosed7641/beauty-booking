generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entity {
  id                    String        @id @default(uuid())
  numberId              Int           @unique @default(autoincrement())
  logo                  String?
  cover                 String?
  name                  String?
  contactUrl            String?
  countryId             String
  ownerId               String        @unique
  address               String?
  addressReference      String?
  shopType              String?
  createdAt             DateTime      @default(now())
  cancelDateTime        Int           @default(20) 
  linkingCode           String        @unique
  country               Country       @relation(fields: [countryId], references: [id])
  owner                 User          @relation("EntityOwner", fields: [ownerId], references: [id])
  services              Service[]
  users                 User[]
  workdays              WorkDay[]
  samples               WorkSample[]
  blockedUsers          BlockedUser[]
  customers             Customer[]
  events                Event[]
  followers             Follower[]
}

model User {
  id                  String            @id @default(uuid())
  name                String?
  birthDay            DateTime?
  gender              Gender?
  role                Role              @default(user)
  photo               String?
  indicator           String?
  phone               String?
  shareNumberPhone    Boolean           @default(false)
  description         String?
  artisticName        String?
  experienceArea      String?
  experienceYears     String?
  countryId           String?
  entityId            String?
  email               String            @unique
  password            String
  isPublicProfile     Boolean           @default(true)
  isRegisterCompleted Boolean           @default(false)
  isActive            Boolean           @default(true)
  entityOwner         Entity?           @relation("EntityOwner")
  professionalEvents  Event[]           @relation("EventProfessional")
  country             Country?          @relation(fields: [countryId], references: [id])
  entity              Entity?           @relation(fields: [entityId], references: [id])
  samples             WorkSample[]
  workExperiences     WorkExperience[]
  skills              Skill[]
  workDays            WorkDay[]
  serviceOverrides    ServiceOverride[]
  blockedUsers        BlockedUser[]
  customers           Customer[]
  followers           Follower[]
}

model Customer {
  id       String  @id @default(uuid())
  userId   String?
  entityId String

  name      String?
  indicator String?
  phone     String?
  birthDay  DateTime?
  gender    Gender?

  createdAt DateTime @default(now())
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  events    Event[]
}

model Follower {
  id       String @id @default(uuid())
  userId   String
  entityId String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
}

model BlockedUser {
  id       String @id @default(uuid())
  userId   String
  entityId String

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityId])
}

model Event {
  id              String       @id @default(uuid())
  title           String
  start           DateTime
  end             DateTime
  typeBooking     String
  status          EventStatus?
  customerId      String
  professionalId  String
  serviceId       String
  price           Int
  durationHours   Int
  durationMinutes Int

  customerRating  Float?
  customerComment String?
  customerRatedAt DateTime?

  professionalRating  Float?
  professionalRatedAt DateTime?

  entityId String

  customer     Customer @relation(fields: [customerId], references: [id])
  professional User     @relation("EventProfessional", fields: [professionalId], references: [id])
  service      Service  @relation(fields: [serviceId], references: [id])
  entity       Entity   @relation(fields: [entityId], references: [id])
}

model Service {
  id          String  @id @default(uuid())
  name        String
  category    String
  description String?

  basePrice           Int @default(0)
  baseDurationHours   Int @default(0)
  baseDurationMinutes Int @default(30)

  gender   Gender?
  archived Boolean @default(false)

  entityId String

  entity           Entity            @relation(fields: [entityId], references: [id])
  events           Event[]
  serviceOverrides ServiceOverride[]
}

model ServiceOverride {
  id String @id @default(uuid())

  serviceId      String
  professionalId String

  price           Int
  durationHours   Int
  durationMinutes Int

  enabled      Boolean @default(true)
  service      Service @relation(fields: [serviceId], references: [id])
  professional User    @relation(fields: [professionalId], references: [id])

  @@unique([serviceId, professionalId])
}

model Skill {
  id         String  @id @default(uuid())
  name       String
  percentage Float
  userId     String?
  user       User?   @relation(fields: [userId], references: [id])
}

model WorkExperience {
  id        String    @id @default(uuid())
  company   String
  position  String
  startDate DateTime
  endDate   DateTime?
  city      String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
}

model WorkDay {
  id             String  @id @default(uuid())
  from           String
  to             String
  name           String
  order          Int
  disabled       Boolean @default(false)
  entityId       String?
  professionalId String?
  entity         Entity? @relation(fields: [entityId], references: [id])
  user           User?   @relation(fields: [professionalId], references: [id])

  @@unique([professionalId, name])
}

model WorkSample {
  id        String            @id @default(uuid())
  category  String
  name      String
  authorId  String
  entityId  String
  updatedAt DateTime          @default(now()) @updatedAt
  author    User              @relation(fields: [authorId], references: [id])
  entity    Entity            @relation(fields: [entityId], references: [id])
  images    WorkSampleImage[]
}

model WorkSampleImage {
  id       String     @id @default(uuid())
  url      String
  main     Boolean?
  sampleId String
  sample   WorkSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
}

model Country {
  id        String   @id @default(uuid())
  name      String
  shortName String
  indicator String
  entity    Entity[]
  users     User[]
}

enum Gender {
  men
  women
  other
}

enum Role {
  admin
  employee
  user
}

enum EventStatus {
  completed
  pending
  cancelled
  aborted
}
