
enum Gender {
  men
  women
}

enum Role {
  admin
  employee
  user
}

enum EventStatus {
  completed
  pending
  cancelled
  aborted
}

model Entity {
    id String @id @default(uuid())
    image String
    name String
    address Address
    review Review[]
    followers Int
    scheduling Int
    contactUrl String
    workdays WorkDay[]
}

model Event {
    id String @id @default(uuid())
    title String
    start DateTime
    end DateTime
    customer User
    selectedService Service
    selectedProfessional User
    isAdminBooking Boolean
    customerReview Review
    status EventStatus?
}

model Review {
    id String @id @default(uuid())

    // Usuario que deja la reseña
    user User @relation("UserReviews", fields: [userId], references: [id])
    userId String

    // Profesional que recibe la reseña
    professional User @relation("ProfessionalReviews", fields: [professionalId], references: [id])
    professionalId String

    entity Entity @relation(fields: [entityId], references: [id])
    entityId String @unique
    date DateTime
    points Float
}

model Service {
  id String @id @default(uuid())
  name String
  description String?
  price Int
  gender Gender?
  category ServiceCategory
  durationHours Int
  durationMinutes Int
  
  archived Boolean?
  entity Entity @relation(fields: [entityId], references: [id])
  entityId String @unique

}

model ServiceCategory {
  id String @id @default(uuid())
  entity Entity @relation(fields: [entityId], references: [id])
  entityId String @unique
  category String
}

model WorkExperience {
  id String @id @default(uuid())
  workName String
  position String
  startDate DateTime
  endDate DateTime?
  stillWorkHere Boolean @default(false)
  place String
  experience String

  user User @relation(fields: [userId], references: [id])
  userId String @unique
}

model WorkSampleImage {
    id String @id @default(uuid())
    mainImage Boolean
    url String
}

model WorkSample {
    id String @id @default(uuid())
    category String
    name String
    images WorkSampleImage[]
    author User
    entity Entity @relation(fields: [entityId], references: [id])
    entityId String @unique
}

model WorkSkill {
  id String @id @default(uuid())
  name String
  percentage Float
}


model WorkDay {
  id String @id @default(uuid())
  from String
  to String
  disabled Boolean @default(false)
}

model Country {
  id String @id @default(uuid())
  name String
  shortName String
}

model User {
    id String @id @default(uuid())
    name String
    country Country @relation(fields: [countryId], references: [id])
    countryId String? @unique
    photo String?
    indicator String?
    phone String?
    birthDay DateTime
    gender Gender
    shareNumberPhone Boolean?
    role Role @default(user)
    review Review[]
    // employee & admin
    entity Entity @relation(fields: [entityId], references: [id])
    entityId String? @unique
    services Service[]
    workdays WorkDay[]

     // Reviews que el usuario escribió
    reviewsWritten Review[] @relation("UserReviews")

    // Reviews que el usuario recibió como profesional
    reviewsReceived Review[] @relation("ProfessionalReviews")
    description String?
    artisticName String?
    experienceArea String?
    experienceYears String?
}

model Address {
    street String
    city String
    state String
    country String
    reference String?

    entity Entity @relation(fields: [entityId], references: [id])
    entityId String @unique
}